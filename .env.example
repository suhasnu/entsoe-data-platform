# Copy to .env and fill in. Never commit .env.

# ENTSO-E Transparency Platform (request access: transparency@entsoe.eu)
ENTSOE_API_KEY=replace_me

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=gridflow
