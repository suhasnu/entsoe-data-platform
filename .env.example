# Copy to .env and fill in. Never commit .env.

# ENTSO-E Transparency Platform (request access: transparency@entsoe.eu)
ENTSOE_API_KEY=replace_me

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=gridflow
POSTGRES_USER=gridflow_app
POSTGRES_PASSWORD=change_me_locally

# Application
GRIDFLOW_ENV=local
LOG_LEVEL=INFO
ZONES=DE_LU,AT,NL,FR,DK_1,DK_2

#BigQuery
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/suhas/.gcp/entsoe-sa.json
GCP_PROJECT_ID=your-project-id
BQ_LOCATION=EU
BQ_DATASET_BRONZE=bronze
GCP_KEYFILE_PATH=C:/Users/suhas/.gcp/entsoe-sa.json

#Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_locally

#FastAPI
API_KEYS=replace_me
BQ_DATASET_MARTS=gridflow_marts

#Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_LOAD=entsoe.load.raw
KAFKA_CONSUMER_GROUP=gridflow-landing
STREAM_LANDING_PATH=data/stream/load
STREAM_HOURLY_PATH=data/stream/hourly
BQ_DATASET_STAGING=gridflow_staging